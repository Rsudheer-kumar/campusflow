# ============================================================
# CampusFlow - Root Environment Configuration Example
# Copy this file to .env for local monorepo development.
# ============================================================

# Runtime Environment (development | production | test)
NODE_ENV=development

# Express Backend API Server Port
PORT=5000

# MongoDB Connection URI (Replica set rs0 required for transactions)
MONGODB_URI=mongodb://127.0.0.1:27018/campusflow?replicaSet=rs0&directConnection=true

# Local Windows development MongoDB auto-start (optional)
MONGODB_AUTO_START=false
MONGOD_PATH=C:\Program Files\MongoDB\Server\8.2\bin\mongod.exe
MONGODB_CONFIG_PATH=C:\path\to\campus-booking-platform\mongod-rs0.conf

# Redis Connection URL (Optional - degraded fallback mode active if unavailable)
REDIS_URL=redis://localhost:6379

# Allowed CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:3000
